{
  "name": "usagekit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Local usagekit monorepo scaffold. No published packages.",
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.3 <11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "setup": "node scripts/check-runtime.mjs && node scripts/install-hooks.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test": "node --test scripts/tests/*.test.mjs",
    "check": "npm run check:runtime && npm run check:workspace && npm run check:format && npm run typecheck && npm test",
    "approve:main": "node scripts/approve-main.mjs",
    "prepublishOnly": "node scripts/deny-publish.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "@types/node": "22.20.4"
  }
}
